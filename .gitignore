# ==========================================
# AutoClaim Pro - Git Ignore Configuration
# ==========================================

# Environment variables & API credentials (NEVER commit secrets!)
.env
.env.*
!.env.example
*.env
*.csv
!sample*.csv
*-credentials*
*api-key*
*.key
*.pem
*.cert
*.crt

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Packaging & Builds
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.tox/

# Logs & Temporary runtime files
*.log
logs/
temp/
tmp/
temp_uploads/
*.sqlite3
*.db

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
